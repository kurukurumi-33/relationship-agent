# 二选一：DeepSeek 官方
DEEPSEEK_API_KEY=
RELATIONSHIP_MODEL_ID=deepseek-v4-pro

# 或者任意 OpenAI 兼容端点（百炼 compatible-mode 示例）
# RELATIONSHIP_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RELATIONSHIP_MODEL_API_KEY=sk-xxx
# RELATIONSHIP_MODEL_ID=qwen-plus

# 数据库：配上就连 PostgreSQL，不配就用本地 SQLite（data/*.db）
# docker compose up -d 之后把下面这行取消注释
# DATABASE_URL=postgresql://relation:relation@localhost:5432/relation

# 截图 OCR（多模态）。不配也能跑，图片会落 pending_review 等人工确认。
# 百炼 compatible-mode 的视觉模型够用，默认 qwen3-vl-plus（纯文字识别可换 qwen-vl-ocr）。
# 各账号可见的模型不同，可以先 GET /compatible-mode/v1/models 看有哪些。
# DASHSCOPE_API_KEY=sk-xxx
# RELATIONSHIP_OCR_API_KEY=sk-xxx
# RELATIONSHIP_OCR_MODEL=qwen3-vl-plus
# RELATIONSHIP_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1